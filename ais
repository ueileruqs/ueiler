#!/usr/bin/env python3
"""Visualizador de cartas AISWEB. Uso: python3 aisweb_viewer.py  (abre http://localhost:8765)
Busca a página pública do aeródromo no site da AISWEB, extrai as cartas e as exibe lado a lado.
Só biblioteca padrão do Python 3.8+. Escuta apenas em 127.0.0.1."""
import hashlib, json, os, re, threading, time, webbrowser
from html.parser import HTMLParser
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
from urllib.parse import urlparse, parse_qs, urljoin
from urllib.request import Request, urlopen

PORT = 8765
BASE = "https://aisweb.decea.mil.br/"
CACHE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "cache_aisweb")
os.makedirs(CACHE, exist_ok=True)
UA = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/120 Safari/537.36",
      "Accept-Language": "pt-BR,pt;q=0.9", "Referer": BASE}
SKIP = {"METAR", "TAF", "NOTAM", "ROTAER", "TEMP", "RCR"}
LISTAS = {}  # codigo -> (timestamp, dados)


def baixar(url, timeout=60):
    with urlopen(Request(url, headers=UA), timeout=timeout) as r:
        return r.read(), r.headers.get("Content-Type", "")


class Parser(HTMLParser):
    """Percorre o HTML em ordem: títulos (ADC, IAC, SID...) definem o tipo; links /download/?arquivo= são as cartas."""
    def __init__(s, base):
        super().__init__(); s.base = base; s.tipo = "OUTRO"; s.cartas = []; s.title = ""
        s.buf = None; s.mode = None; s.tag = None; s.href = None

    def handle_starttag(s, tag, attrs):
        if tag in ("h1", "h2", "h3", "h4", "h5", "h6"):
            s.buf = []; s.mode = "h"; s.tag = tag
        elif tag == "a":
            h = dict(attrs).get("href") or ""
            if "download/?arquivo=" in h or "download?arquivo=" in h:
                s.href = urljoin(s.base, h); s.buf = []; s.mode = "a"

    def handle_data(s, d):
        if s.buf is not None:
            s.buf.append(d)

    def handle_endtag(s, tag):
        if s.mode == "h" and tag == s.tag:
            t = " ".join("".join(s.buf).split())
            if tag == "h1" and not s.title and "(" in t:
                s.title = t
            if re.fullmatch(r"[A-Z]{2,7}", t) and t not in SKIP:
                s.tipo = t
            s.buf = None; s.mode = None
        elif s.mode == "a" and tag == "a":
            nome = " ".join("".join(s.buf).split()) or "(sem nome)"
            s.cartas.append({"tipo": s.tipo, "nome": nome, "url": s.href})
            s.buf = None; s.mode = None; s.href = None


def aerodromo(codigo, fresco=False):
    if not fresco and codigo in LISTAS and time.time() - LISTAS[codigo][0] < 1800:
        return LISTAS[codigo][1]
    html = baixar(BASE + "?i=aerodromos&codigo=" + codigo, 40)[0].decode("utf-8", "replace")
    p = Parser(BASE); p.feed(html)
    vistos, cartas = set(), []
    for c in p.cartas:
        if c["url"] not in vistos:
            vistos.add(c["url"]); cartas.append(c)
    if not cartas:
        raise ValueError("Nenhuma carta encontrada para " + codigo + " (código inexistente ou o site mudou o formato).")
    nome = re.sub(r"\s*CIAD:.*$", "", p.title).strip() or codigo
    dados = {"codigo": codigo, "nome": nome, "cartas": cartas}
    LISTAS[codigo] = (time.time(), dados)
    return dados


def carta(url):
    h = urlparse(url)
    if h.scheme != "https" or not (h.hostname or "").endswith((".decea.gov.br", ".decea.mil.br")) or not h.path.startswith("/download"):
        raise ValueError("URL não permitida")
    chave = os.path.join(CACHE, hashlib.sha1(url.encode()).hexdigest())
    if os.path.exists(chave + ".bin"):
        return open(chave + ".bin", "rb").read(), open(chave + ".ct").read()
    corpo, ct = baixar(url)
    if "pdf" in ct.lower() or corpo[:4] == b"%PDF":
        ct = "application/pdf"
    open(chave + ".bin", "wb").write(corpo); open(chave + ".ct", "w").write(ct)
    return corpo, ct


class H(BaseHTTPRequestHandler):
    def log_message(s, *a): pass

    def resp(s, code, corpo, ct, extra=None):
        s.send_response(code); s.send_header("Content-Type", ct); s.send_header("Content-Length", str(len(corpo)))
        for k, v in (extra or {}).items(): s.send_header(k, v)
        s.end_headers(); s.wfile.write(corpo)

    def do_GET(s):
        u = urlparse(s.path); q = parse_qs(u.query)
        try:
            if u.path == "/":
                s.resp(200, PAGE.encode(), "text/html; charset=utf-8")
            elif u.path == "/api/aerodromo":
                cod = (q.get("codigo", [""])[0]).strip().upper()
                if not re.fullmatch(r"[A-Z0-9]{3,4}", cod): raise ValueError("Código ICAO inválido")
                s.resp(200, json.dumps(aerodromo(cod, "fresh" in q)).encode(), "application/json")
            elif u.path == "/carta":
                corpo, ct = carta(q.get("u", [""])[0])
                s.resp(200, corpo, ct, {"Content-Disposition": "inline"})
            else:
                s.resp(404, b"404", "text/plain")
        except Exception as e:
            try: s.resp(502, json.dumps({"erro": str(e)}).encode(), "application/json")
            except Exception: pass


